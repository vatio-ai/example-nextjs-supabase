# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: the project URL and its anon (or sb_publishable_) key, from the
# dashboard's Connect dialog or Project Settings → API Keys. Both are public.
# Never put the service-role or a secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vatio: the workspace slug (the `workspace:` line in vatio.yml) and a
# publishable key (vatpub_…) that allows this origin:
#   npx @vatio-ai/cli@latest keys create publishable --env preview --origin http://localhost:3000
# Leave them empty and the app runs without the chat bubble.
NEXT_PUBLIC_VATIO_WORKSPACE=
NEXT_PUBLIC_VATIO_TOKEN=
